<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>Primer.Tests</RootNamespace>
		<LangVersion>latestmajor</LangVersion>
		<OutputType>Library</OutputType>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>Primer.Tests.Base</PackageId>
		<Version>1.0.0</Version>
		<Authors>kjerk</Authors>
		<Description>Test infrastructure for Primer-based ASP.NET applications. Provides base classes for HTTP and Playwright browser testing with automatic Primer test mode integration.</Description>
		<PackageTags>aspnet;testing;primer;testbase;playwright;integration-testing</PackageTags>
		<PackageProjectUrl>https://github.com/kjerk/Primer</PackageProjectUrl>
		<RepositoryUrl>https://github.com/kjerk/Primer</RepositoryUrl>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Microsoft.AspNetCore.Builder" />
		<Using Include="Microsoft.Extensions.DependencyInjection" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.*" />
		<PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.*" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.*" />
		<PackageReference Include="Microsoft.AspNetCore.TestHost" Version="9.0.*" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
		<PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Playwright.NUnit" Version="1.58.0" />
		<PackageReference Include="NUnit" Version="4.5.1" />
		<PackageReference Include="System.IO.Abstractions" Version="22.1.0" />
		<PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="22.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Primer\Primer.csproj" />
	</ItemGroup>

</Project>
